ShowHelp() {
  echo ""
  echo "Alire RP2040 ARM Microcontroller Project Creator"
  echo ""
  if [ $# -eq 1 ]; then
    echo $1
    echo ""
  fi
  echo "Usage: alire-newproject-rp2040 <program name> embedded|light_tasking"
  echo ""
  exit 1
}

progname=$1
profile=$2

# Validate parameters

test $# -ne 2 && ShowHelp
test -e munts_rp2040_firmware_${profile}_* && ShowHelp "ERROR: munts_rp2040_firmware_${profile} already exists."
test -e ${progname} && ShowHelp "ERROR: ${progname} already exists."

alr -n get munts_rp2040_firmware_${profile}
alire-rename munts_rp2040_firmware_${profile}_* ${progname}
